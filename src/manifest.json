{
  "manifest_version": 3,
  "name": "BtrKorone",
  "version": "2.4.3",
  "description": "Enhances the Korone (Pekora) revival site with verified premium tiers, a play button, RoPro-style trade modal, and desktop notifications for new trades.",
  "author": "BtrKorone Community",
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "*://*.pekora.zip/*",
    "*://*.korone.live/*",
    "*://www.koromons.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.pekora.zip/*"],
      "js": ["content/page-spy.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.korone.live/*", "*://*.pekora.zip/*"],
      "js": [
        "shared/constants.js",
        "shared/storage.js",
        "shared/koromons-api.js",
        "shared/pekora-api.js",
        "content/main.js",
        "content/ui-enhancements.js",
        "content/premium-features.js",
        "content/trade-features.js"
      ],
      "css": ["content/styles/btrkorone.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content/styles/*", "icons/*", "content/page-spy.js"],
      "matches": ["*://*.korone.live/*", "*://*.pekora.zip/*"]
    }
  ]
}
